def click_student(driver):
    """'Student' radio button ya label select karta hai"""
    try:
        el = driver.find_element(
            By.XPATH,
            "//input[@type='radio' and contains(translate(@value, 'STUDENT', 'student'), 'student')] | "
            "//input[@type='radio' and contains(translate(@id, 'STUDENT', 'student'), 'student')] | "
            "//label[contains(translate(text(), 'STUDENT', 'student'), 'student')] | "
            "//button[contains(translate(text(), 'STUDENT', 'student'), 'student')] | "
            "//a[contains(translate(text(), 'STUDENT', 'student'), 'student')]"
        )
        driver.execute_script("arguments[0].click();", el)
        print("🎯 'Student' select ho gaya.")
        return True
    except Exception:
        return False

