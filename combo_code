  =========================================================================
     👇 APNA FUNCTION: Naya DOB dene ke liye (0000 se 9999 tak) 👇
 =========================================================================
demo_dobs = [f"{s:04d}" for s in range(10000)]

def get_next_dob():
    """Yeh function har baar agli DOB return karega."""
    if demo_dobs:
        return demo_dobs.pop(0)
    return None

