import string
from itertools import product

PREFIX = "whi prani wali bat"       # Shuru me jo aayega smj le n yarr 
SUFFIX = "isme bhi whi"         # Last me jo aayega ab copy pesh krna  pdega sabhi me yarr
LENGTH = 4           # Kitne characters ka mix combination banana hai

# 1. Letters (a-z, A-Z)
letters = string.ascii_letters

# 2. Numbers (0-9)
numbers = string.digits

# 3. Symbols (!"#$%&'()*+,-./:;<=>?@[\]^_`{|}~)
symbols = string.punctuation

# Sabhi ko ek sath jod liya:
CHARS = letters + numbers + symbols

# Sabhi possible combinations ka generator
combinations = product(CHARS, repeat=LENGTH)

def get_next_dob():
    
    item = next(combinations, None)
    if item is not None:
        return f"{PREFIX}{''.join(item)}{SUFFIX}"
    return None
