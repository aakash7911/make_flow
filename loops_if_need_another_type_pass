import string
from itertools import product

PREFIX = "const"       # Shuru me kya aayega
SUFFIX = "back const "         # Last me kya aayega
LENGTH = 4           # Kitne characters ka combination banana hai

# Character set choose karein:
# 1. Sirf chote letters ke liye:
CHARS = string.ascii_lowercase                     # 'abcdefghijklmnopqrstuvwxyz'

# 2. Agar capital letters bhi chahiye toh:
# CHARS = string.ascii_letters                     # a-z aur A-Z dono

# 3. Agar letters + numbers dono mix chahiye toh:
# CHARS = string.ascii_lowercase + string.digits   # a-z aur 0-9 dono


# Sabhi combinations generate karne ke liye iterator
combinations = product(CHARS, repeat=LENGTH)

