PREFIX = "PU@"   # Shuru me kya aayega
SUFFIX = "#"     # Last me kya aayega (khaali chhodna ho toh "" kar dein)
DIGITS = 4       # Kitne digit ka number rakhna hai (jaise 4 -> 0000, 3 -> 000)

demo_dobs = [f"{PREFIX}{s:0{DIGITS}d}{SUFFIX}" for s in range(10**DIGITS)]

def get_next_dob():
    if demo_dobs:
        return demo_dobs.pop(0)
    return None


